{
  "name": "opencode-filetree",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./dist/tui.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "opentui-types-core": "npm:@opentui/core@0.5.14",
    "opentui-types-solid": "npm:@opentui/solid@0.5.14",
    "solid-types": "npm:solid-js@1.9.15",
    "typescript": "latest"
  },
  "scripts": {
    "postinstall": "node scripts/strip-opentui-runtime.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-dist-extensions.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  }
}
